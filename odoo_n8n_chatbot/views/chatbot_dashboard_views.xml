<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Dashboard Form View -->
        <record id="view_n8n_dashboard_form" model="ir.ui.view">
            <field name="name">n8n.dashboard.form</field>
            <field name="model">n8n.workflow</field>
            <field name="arch" type="xml">
                <form string="n8n Dashboard" create="false" edit="false" delete="false">
                    <sheet>
                        <div class="o_dashboard">
                            <div class="row">
                                <div class="col-lg-12">
                                    <h1>n8n Integration Dashboard</h1>
                                    <p class="text-muted">Monitor your workflow automations and performance</p>
                                </div>
                            </div>
                            
                            <!-- Statistics Cards -->
                            <div class="row o_dashboard_stats">
                                <div class="col-lg-3 col-md-6">
                                    <div class="card bg-primary text-white">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between">
                                                <div>
                                                    <h4 class="card-title">Active Workflows</h4>
                                                    <h2 class="mb-0" id="active_workflows_count">-</h2>
                                                </div>
                                                <div class="align-self-center">
                                                    <i class="fa fa-cogs fa-2x"></i>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="col-lg-3 col-md-6">
                                    <div class="card bg-success text-white">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between">
                                                <div>
                                                    <h4 class="card-title">Total Executions</h4>
                                                    <h2 class="mb-0" id="total_executions">-</h2>
                                                </div>
                                                <div class="align-self-center">
                                                    <i class="fa fa-play fa-2x"></i>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="col-lg-3 col-md-6">
                                    <div class="card bg-info text-white">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between">
                                                <div>
                                                    <h4 class="card-title">Success Rate</h4>
                                                    <h2 class="mb-0" id="success_rate">-%</h2>
                                                </div>
                                                <div class="align-self-center">
                                                    <i class="fa fa-check-circle fa-2x"></i>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="col-lg-3 col-md-6">
                                    <div class="card bg-warning text-white">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between">
                                                <div>
                                                    <h4 class="card-title">Avg Response Time</h4>
                                                    <h2 class="mb-0" id="avg_response_time">-ms</h2>
                                                </div>
                                                <div class="align-self-center">
                                                    <i class="fa fa-clock-o fa-2x"></i>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Charts and Tables -->
                            <div class="row mt-4">
                                <div class="col-lg-8">
                                    <div class="card">
                                        <div class="card-header">
                                            <h5 class="card-title mb-0">Execution Trends (Last 30 Days)</h5>
                                        </div>
                                        <div class="card-body">
                                            <canvas id="execution_trends_chart" height="300"></canvas>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="col-lg-4">
                                    <div class="card">
                                        <div class="card-header">
                                            <h5 class="card-title mb-0">Status Distribution</h5>
                                        </div>
                                        <div class="card-body">
                                            <canvas id="status_distribution_chart" height="300"></canvas>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="row mt-4">
                                <div class="col-lg-6">
                                    <div class="card">
                                        <div class="card-header d-flex justify-content-between align-items-center">
                                            <h5 class="card-title mb-0">Top Workflows</h5>
                                            <small class="text-muted">By execution count</small>
                                        </div>
                                        <div class="card-body">
                                            <div class="table-responsive">
                                                <table class="table table-sm" id="top_workflows_table">
                                                    <thead>
                                                        <tr>
                                                            <th>Workflow</th>
                                                            <th>Executions</th>
                                                            <th>Success Rate</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <!-- Populated by JavaScript -->
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="col-lg-6">
                                    <div class="card">
                                        <div class="card-header d-flex justify-content-between align-items-center">
                                            <h5 class="card-title mb-0">Recent Activity</h5>
                                            <small class="text-muted">Last 10 executions</small>
                                        </div>
                                        <div class="card-body">
                                            <div class="table-responsive">
                                                <table class="table table-sm" id="recent_activity_table">
                                                    <thead>
                                                        <tr>
                                                            <th>Time</th>
                                                            <th>Workflow</th>
                                                            <th>User</th>
                                                            <th>Status</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <!-- Populated by JavaScript -->
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Quick Actions -->
                            <div class="row mt-4">
                                <div class="col-lg-12">
                                    <div class="card">
                                        <div class="card-header">
                                            <h5 class="card-title mb-0">Quick Actions</h5>
                                        </div>
                                        <div class="card-body">
                                            <div class="btn-toolbar" role="toolbar">
                                                <div class="btn-group mr-2" role="group">
                                                    <button type="button" class="btn btn-primary" onclick="location.href='/web#action=odoo_n8n_chatbot.action_n8n_workflow'">
                                                        <i class="fa fa-plus"></i> Create Workflow
                                                    </button>
                                                    <button type="button" class="btn btn-secondary" onclick="location.href='/web#action=odoo_n8n_chatbot.action_n8n_execution_log'">
                                                        <i class="fa fa-list"></i> View Logs
                                                    </button>
                                                </div>
                                                <div class="btn-group mr-2" role="group">
                                                    <button type="button" class="btn btn-info" onclick="refreshDashboard()">
                                                        <i class="fa fa-refresh"></i> Refresh
                                                    </button>
                                                    <button type="button" class="btn btn-warning" onclick="location.href='/web#action=base.action_res_config_settings&amp;view_type=form'">
                                                        <i class="fa fa-cog"></i> Settings
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- Dashboard Action -->
        <record id="action_n8n_dashboard" model="ir.actions.act_window">
            <field name="name">n8n Dashboard</field>
            <field name="res_model">n8n.workflow</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_n8n_dashboard_form"/>
            <field name="target">current</field>
            <field name="context">{}</field>
        </record>
        
        <!-- Dashboard Client Action -->
        <record id="action_n8n_dashboard_client" model="ir.actions.client">
            <field name="name">n8n Dashboard</field>
            <field name="tag">n8n_dashboard</field>
            <field name="target">current</field>
        </record>
        
    </data>
</odoo>