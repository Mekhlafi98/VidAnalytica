<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- n8n Workflow Tree View -->
        <record id="view_n8n_workflow_tree" model="ir.ui.view">
            <field name="name">n8n.workflow.tree</field>
            <field name="model">n8n.workflow</field>
            <field name="arch" type="xml">
                <tree string="n8n Workflows" decoration-muted="not active" decoration-success="active">
                    <field name="sequence" widget="handle"/>
                    <field name="active" invisible="1"/>
                    <field name="name"/>
                    <field name="description"/>
                    <field name="trigger_keywords" string="Keywords"/>
                    <field name="execution_count" string="Executions"/>
                    <field name="success_rate" string="Success Rate" widget="percentage"/>
                    <field name="last_execution" string="Last Run"/>
                    <field name="active" widget="boolean_toggle"/>
                </tree>
            </field>
        </record>
        
        <!-- n8n Workflow Form View -->
        <record id="view_n8n_workflow_form" model="ir.ui.view">
            <field name="name">n8n.workflow.form</field>
            <field name="model">n8n.workflow</field>
            <field name="arch" type="xml">
                <form string="n8n Workflow">
                    <header>
                        <button name="test_workflow" string="Test Workflow" type="object" 
                                class="btn-primary" attrs="{'invisible': [('active', '=', False)]}"/>
                        <button name="action_view_execution_logs" string="View Logs" type="object" 
                                class="btn-secondary"/>
                        <field name="active" widget="boolean_button" 
                               options="{'terminology': {'string_true': 'Active', 'string_false': 'Inactive'}}"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" type="object" name="action_view_execution_logs" icon="fa-list-alt">
                                <field string="Executions" name="execution_count" widget="statinfo"/>
                            </button>
                            <button class="oe_stat_button" type="object" name="action_view_execution_logs" icon="fa-check-circle">
                                <field string="Success Rate" name="success_rate" widget="statinfo" options="{'suffix': '%'}"/>
                            </button>
                        </div>
                        
                        <group>
                            <group>
                                <field name="name" placeholder="e.g., Create Lead Workflow"/>
                                <field name="description" placeholder="Brief description of what this workflow does"/>
                                <field name="sequence"/>
                            </group>
                            <group>
                                <field name="last_execution" readonly="1"/>
                                <field name="log_executions"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Trigger Configuration" name="triggers">
                                <group>
                                    <group>
                                        <field name="trigger_keywords" widget="text" 
                                               placeholder="create lead&#10;new customer&#10;add contact"/>
                                        <field name="regex_mode"/>
                                        <field name="case_sensitive"/>
                                    </group>
                                    <group>
                                        <field name="template_variables" widget="text" 
                                               placeholder='{"customer_name": "\\b([A-Z][a-z]+ [A-Z][a-z]+)\\b", "email": "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Z|a-z]{2,}\\b"}'
                                               attrs="{'invisible': [('regex_mode', '=', False)]}"/>
                                    </group>
                                </group>
                                <div class="alert alert-info" role="alert" attrs="{'invisible': [('regex_mode', '=', False)]}">
                                    <strong>Regex Mode Tips:</strong><br/>
                                    • Use named groups in regex: (?P&lt;customer_name&gt;[A-Z][a-z]+ [A-Z][a-z]+)<br/>
                                    • Template variables should match group names<br/>
                                    • Test your patterns carefully before activating
                                </div>
                            </page>
                            
                            <page string="n8n Configuration" name="n8n_config">
                                <group>
                                    <group>
                                        <field name="n8n_webhook_url" placeholder="https://n8n.example.com/webhook/..."/>
                                        <field name="webhook_method"/>
                                        <field name="n8n_api_key" password="True" placeholder="Optional API key"/>
                                    </group>
                                    <group>
                                        <field name="callback_url" readonly="1" widget="url"/>
                                        <field name="expect_callback"/>
                                        <field name="timeout_seconds"/>
                                    </group>
                                </group>
                                <div class="alert alert-warning" role="alert">
                                    <strong>Setup Instructions:</strong><br/>
                                    1. Create a webhook trigger in your n8n workflow<br/>
                                    2. Copy the webhook URL to the field above<br/>
                                    3. If expecting responses, configure n8n to POST back to the Callback URL<br/>
                                    4. Test the workflow using the "Test Workflow" button
                                </div>
                            </page>
                            
                            <page string="Security &amp; Access" name="security">
                                <group>
                                    <group string="User Permissions">
                                        <field name="allowed_user_ids" widget="many2many_tags" 
                                               placeholder="Leave empty to allow all users"/>
                                        <field name="allowed_group_ids" widget="many2many_tags"/>
                                    </group>
                                </group>
                                <div class="alert alert-info" role="alert">
                                    <strong>Permission Logic:</strong><br/>
                                    • If both Users and Groups are empty, all users can trigger this workflow<br/>
                                    • If either is specified, only those users/group members can trigger it<br/>
                                    • Users in specified groups OR individually listed users can trigger
                                </div>
                            </page>
                            
                            <page string="Response Template" name="response">
                                <group>
                                    <field name="response_template" widget="text" 
                                           placeholder="Processing your request for {customer_name}... Please wait.&#10;&#10;Available variables: {workflow_name}, {user_name}, and any extracted variables"/>
                                </group>
                                <div class="alert alert-success" role="alert">
                                    <strong>Template Variables:</strong><br/>
                                    • <code>{workflow_name}</code> - Name of this workflow<br/>
                                    • <code>{user_name}</code> - Name of the user who triggered the workflow<br/>
                                    • Any variables defined in the Template Variables field<br/>
                                    • Use Python string formatting syntax: <code>{variable_name}</code>
                                </div>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- n8n Workflow Search View -->
        <record id="view_n8n_workflow_search" model="ir.ui.view">
            <field name="name">n8n.workflow.search</field>
            <field name="model">n8n.workflow</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" string="Workflow" 
                           filter_domain="['|', ('name', 'ilike', self), ('description', 'ilike', self)]"/>
                    <field name="trigger_keywords"/>
                    <field name="allowed_user_ids"/>
                    <field name="allowed_group_ids"/>
                    
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
                    <separator/>
                    <filter string="With Callbacks" name="with_callbacks" domain="[('expect_callback', '=', True)]"/>
                    <filter string="No Callbacks" name="no_callbacks" domain="[('expect_callback', '=', False)]"/>
                    <separator/>
                    <filter string="Regex Mode" name="regex_mode" domain="[('regex_mode', '=', True)]"/>
                    <filter string="Simple Mode" name="simple_mode" domain="[('regex_mode', '=', False)]"/>
                    
                    <group expand="0" string="Group By">
                        <filter string="Status" name="group_active" domain="[]" context="{'group_by': 'active'}"/>
                        <filter string="Callback Expected" name="group_callback" domain="[]" context="{'group_by': 'expect_callback'}"/>
                        <filter string="Regex Mode" name="group_regex" domain="[]" context="{'group_by': 'regex_mode'}"/>
                    </group>
                </search>
            </field>
        </record>
        
        <!-- n8n Workflow Kanban View -->
        <record id="view_n8n_workflow_kanban" model="ir.ui.view">
            <field name="name">n8n.workflow.kanban</field>
            <field name="model">n8n.workflow</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" default_group_by="active">
                    <field name="active"/>
                    <field name="name"/>
                    <field name="description"/>
                    <field name="execution_count"/>
                    <field name="success_rate"/>
                    <field name="last_execution"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <div class="o_kanban_record_body">
                                        <field name="description"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <span class="badge badge-pill badge-info">
                                            <field name="execution_count"/> runs
                                        </span>
                                        <span class="badge badge-pill badge-success" t-if="record.success_rate.raw_value > 80">
                                            <field name="success_rate"/>% success
                                        </span>
                                        <span class="badge badge-pill badge-warning" t-elif="record.success_rate.raw_value > 60">
                                            <field name="success_rate"/>% success
                                        </span>
                                        <span class="badge badge-pill badge-danger" t-else="">
                                            <field name="success_rate"/>% success
                                        </span>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <span class="text-muted" t-if="record.last_execution.raw_value">
                                            <field name="last_execution"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        
        <!-- Actions -->
        <record id="action_n8n_workflow" model="ir.actions.act_window">
            <field name="name">n8n Workflows</field>
            <field name="res_model">n8n.workflow</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="context">{'search_default_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first n8n workflow integration!
                </p>
                <p>
                    n8n workflows allow you to automate tasks through natural language commands in the chatbot.
                    Set up trigger keywords, configure your n8n webhook, and start automating!
                </p>
            </field>
        </record>
        
    </data>
</odoo>