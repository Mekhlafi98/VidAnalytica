<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <!-- Categories -->
        <record id="module_category_n8n" model="ir.module.category">
            <field name="name">n8n Integration</field>
            <field name="description">Manage n8n workflow integration permissions</field>
            <field name="sequence">50</field>
        </record>
        
        <!-- Groups -->
        <record id="group_n8n_user" model="res.groups">
            <field name="name">n8n User</field>
            <field name="category_id" ref="module_category_n8n"/>
            <field name="comment">Can trigger n8n workflows through chatbot</field>
        </record>
        
        <record id="group_n8n_manager" model="res.groups">
            <field name="name">n8n Manager</field>
            <field name="category_id" ref="module_category_n8n"/>
            <field name="implied_ids" eval="[(4, ref('group_n8n_user'))]"/>
            <field name="comment">Can manage n8n workflows and view execution logs</field>
        </record>
        
        <record id="group_n8n_admin" model="res.groups">
            <field name="name">n8n Administrator</field>
            <field name="category_id" ref="module_category_n8n"/>
            <field name="implied_ids" eval="[(4, ref('group_n8n_manager'))]"/>
            <field name="comment">Full access to n8n integration including system settings</field>
        </record>
        
        <!-- Record Rules for n8n.workflow -->
        <record id="n8n_workflow_rule_user" model="ir.rule">
            <field name="name">n8n Workflow: User Access</field>
            <field name="model_id" ref="model_n8n_workflow"/>
            <field name="groups" eval="[(4, ref('group_n8n_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[('active', '=', True)]</field>
        </record>
        
        <record id="n8n_workflow_rule_manager" model="ir.rule">
            <field name="name">n8n Workflow: Manager Access</field>
            <field name="model_id" ref="model_n8n_workflow"/>
            <field name="groups" eval="[(4, ref('group_n8n_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        
        <record id="n8n_workflow_rule_admin" model="ir.rule">
            <field name="name">n8n Workflow: Admin Access</field>
            <field name="model_id" ref="model_n8n_workflow"/>
            <field name="groups" eval="[(4, ref('group_n8n_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        
        <!-- Record Rules for n8n.execution.log -->
        <record id="n8n_execution_log_rule_user" model="ir.rule">
            <field name="name">n8n Execution Log: User Access</field>
            <field name="model_id" ref="model_n8n_execution_log"/>
            <field name="groups" eval="[(4, ref('group_n8n_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
        </record>
        
        <record id="n8n_execution_log_rule_manager" model="ir.rule">
            <field name="name">n8n Execution Log: Manager Access</field>
            <field name="model_id" ref="model_n8n_execution_log"/>
            <field name="groups" eval="[(4, ref('group_n8n_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        
        <record id="n8n_execution_log_rule_admin" model="ir.rule">
            <field name="name">n8n Execution Log: Admin Access</field>
            <field name="model_id" ref="model_n8n_execution_log"/>
            <field name="groups" eval="[(4, ref('group_n8n_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        
        <!-- Settings Access -->
        <record id="res_config_settings_rule_admin" model="ir.rule">
            <field name="name">n8n Settings: Admin Only</field>
            <field name="model_id" ref="base.model_res_config_settings"/>
            <field name="groups" eval="[(4, ref('group_n8n_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        
        <!-- Menu Access Rules -->
        <record id="menu_access_rule_user" model="ir.rule">
            <field name="name">n8n Menu: User Access</field>
            <field name="model_id" ref="base.model_ir_ui_menu"/>
            <field name="groups" eval="[(4, ref('group_n8n_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[
                '|',
                ('xml_id', 'not like', 'odoo_n8n_chatbot.menu_%'),
                ('xml_id', 'in', ['odoo_n8n_chatbot.menu_n8n_root', 'odoo_n8n_chatbot.menu_n8n_dashboard'])
            ]</field>
        </record>
        
    </data>
</odoo>